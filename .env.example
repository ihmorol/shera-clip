# Copy to .env (never commit .env). Keys stay on this laptop.
OPENROUTER_API_KEY=
# Zoom cloud-recording import (phase 2; see docs/zoom-setup.md). Leave blank to import local files only.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The teacher's Zoom email or user ID whose cloud recordings are listed
ZOOM_USER=
# Optional overrides
# SHERA_DATA=E:/ShereClipData
# SHERA_STT_MODEL=openai/whisper-large-v3
# SHERA_DRAFT_MODEL=openai/gpt-4o-mini
# SHERA_PORT=8765
